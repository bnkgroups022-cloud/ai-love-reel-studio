# ============================================================
# AI LOVE REEL STUDIO — settings
# Copy this file to ".env.local" (on your computer) and fill it in.
# On Vercel, add the same names under Settings → Environment Variables.
# NEVER put real keys in this file — it is uploaded to GitHub.
# ============================================================

# Your website address (e.g. https://ai-love-reel-studio.vercel.app). Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Private access (single owner) ----------
# The password you type to unlock the app.
APP_ACCESS_PASSWORD=
# A long random secret used to sign your login cookie (64 random characters).
ENCRYPTION_KEY=
# Optional: your email, used as the owner account id in the database.
OWNER_EMAIL=

# ---------- Supabase (database + file storage) ----------
NEXT_PUBLIC_SUPABASE_URL=
# Not used by the app yet (the browser never talks to Supabase directly). Kept for future Google login.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Story AI (writes story, characters, 8 scenes) ----------
# "anthropic" (real AI) or "demo" (fixed test story, clearly labelled)
STORY_PROVIDER=anthropic
# SECRET. From https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5
STORY_MODEL=

# ---------- Image AI (makes the 8 pictures) ----------
# "replicate" (FLUX, recommended), "openai" (gpt-image-1) or "demo" (labelled placeholders)
IMAGE_PROVIDER=replicate
# SECRET. Replicate: https://replicate.com/account/api-tokens  ·  OpenAI: https://platform.openai.com/api-keys
IMAGE_API_KEY=
# Optional. Replicate default: black-forest-labs/flux-1.1-pro  ·  OpenAI default: gpt-image-1
IMAGE_MODEL=

# ---------- Video rendering (makes the MP4) ----------
# "shotstack" (cloud, works on Vercel) or "ffmpeg" (only on your own computer)
VIDEO_PROVIDER=shotstack
# SECRET. From https://dashboard.shotstack.io (API Keys)
VIDEO_API_KEY=
# "stage" = free sandbox key (videos get a watermark) · "v1" = production key
SHOTSTACK_ENV=stage
# Optional, for VIDEO_PROVIDER=ffmpeg: full path to ffmpeg if not installed via npm
FFMPEG_PATH=

# ---------- Limits ----------
MAX_PROJECTS_PER_HOUR=10
